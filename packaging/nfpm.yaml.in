name: spawnr
arch: amd64
platform: linux
version: @SPAWNR_VERSION@
version_schema: semver
release: 1
section: devel
priority: optional
maintainer: Mathias Vandaele <contactvandaele@gmail.com>
description: Spawn isolated, reproducible KVM development computers
vendor: Spawnr
homepage: @SPAWNR_WEBSITE@
license: Apache-2.0
mtime: 1970-01-01T00:00:01Z
contents:
  - src: @SPAWNR_CLI@
    dst: /usr/bin/spawnr
    file_info:
      mode: 0755
      owner: root
      group: root
      mtime: 1970-01-01T00:00:01Z
  - src: @SPAWNR_LICENSE@
    dst: /usr/share/licenses/spawnr/LICENSE
    packager: rpm
    file_info:
      mode: 0644
      owner: root
      group: root
      mtime: 1970-01-01T00:00:01Z
  - src: @SPAWNR_DEBIAN_COPYRIGHT@
    dst: /usr/share/doc/spawnr/copyright
    packager: deb
    file_info:
      mode: 0644
      owner: root
      group: root
      mtime: 1970-01-01T00:00:01Z
  - src: @SPAWNR_README@
    dst: /usr/share/doc/spawnr/README.md
    file_info:
      mode: 0644
      owner: root
      group: root
      mtime: 1970-01-01T00:00:01Z
deb:
  compression: xz
  fields:
    Bugs: https://github.com/@SPAWNR_REPOSITORY@/issues
rpm:
  buildhost: @SPAWNR_DOMAIN@
  compression: xz
  group: Development/Tools
  packager: Mathias Vandaele <contactvandaele@gmail.com>
